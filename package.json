{
  "name": "dinerdost",
  "version": "0.4.32",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@dinerdost/web",
    "build": "npm run build --workspace=@dinerdost/web",
    "start": "npm run start --workspace=@dinerdost/web",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "test:e2e": "playwright test",
    "db:migrate": "tsx scripts/database.ts migrate",
    "db:check": "tsx scripts/database.ts check"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.2.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
