# Production: use an isolated PostgreSQL database and a restricted application role.
DATABASE_URL=
DATABASE_MIGRATION_URL=
# Local development only. PGlite persists PostgreSQL data in this ignored directory.
LOCAL_DATABASE_PATH=.data/postgres
# Public app origin. Production mutations require a matching Origin header.
APP_ORIGIN=http://localhost:5090
# Optional integrations remain unavailable until configured and verified.
RAZORPAY_WEBHOOK_SECRET=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
SMS_PROVIDER_URL=
SMS_PROVIDER_TOKEN=
OPENAI_API_KEY=
